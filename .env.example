# نسخة نموذجية لمتغيرات البيئة — انسخ الملف إلى .env.local واملأ القيم الحقيقية
# لا تضع قيمًا أو توكنات حقيقية في هذا الملف أبدًا (هذا الملف يُرفع للمستودع)

# إلزاميان — من لوحة Turso: turso db show <name> (الرابط) و turso db tokens create <name>
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=

# رابط خدمة الدمج المنشورة (مشروع merger داخل هذا المستودع — انشره أولًا)
MERGER_API_BASE=https://your-merger-deployment.vercel.app

# اختياري: إن ضُبط يُطلب Authorization: Bearer <token> على /mcp
MCP_ACCESS_TOKEN=

# اختياري: تجاوز أسماء الموديلات لكل مزود
KIE_IMAGE_MODEL=
KIE_VIDEO_MODEL=
COMETAPI_IMAGE_MODEL=
COMETAPI_VIDEO_MODEL=
