# نسخة نموذجية لمتغيرات البيئة — انسخ الملف إلى .env واملأ القيم الحقيقية
# لا تضع قيمًا أو توكنات حقيقية في هذا الملف أبدًا (هذا الملف يُرفع للمستودع)

# إلزاميان — من لوحة Turso: turso db show <name> (الرابط) و turso db tokens create <name>
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=

# الحدود — اختيارية (هذه القيم الافتراضية)
MAX_SOURCES=10
SOURCE_MAX_MB=200
OUTPUT_MAX_MB=150
MAX_TOTAL_DURATION_SEC=600
FFMPEG_PRESET=medium
